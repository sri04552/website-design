# ==============================================================================
# Environment Configuration - Professional Freelancer Website
# Copy this file to .env.local and update with your actual credentials.
# Do NOT commit .env.local to Git.
# ==============================================================================

# Business Details & Contact Configuration
NEXT_PUBLIC_BUSINESS_NAME="Sri Digital Studio"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_PHONE_NUMBER="+91 98765 43210"

# WhatsApp Direct Chat Integration
# Format: International country code + digits without spaces, + or dashes (e.g., 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Optional Backend / Database (Supabase)
# Leave blank to run the contact form in local verification fallback mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Email Dispatch (Resend API)
# Leave blank if using Supabase or manual inquiry notification.
RESEND_API_KEY=""
